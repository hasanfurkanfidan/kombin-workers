# Copy to .env (git-ignored) and fill in.
# Base URL of the Kombin backend (local compose stack: 8081).
KOMBIN_API_URL=http://localhost:8081
# Same value as INTERNAL_API_KEY in kombin-backend/docker/.env
KOMBIN_INTERNAL_KEY=...
# Optional: products per source per run (default 400).
# KOMBIN_MAX_ITEMS_PER_SOURCE=400
# Goes into the User-Agent so site owners can reach us. Unset (or this placeholder) = the contact part is left out.
# Before production use a real, non-personal address (e.g. a role mailbox), not a private one.
BOT_CONTACT=[YOUR EMAIL]
